# ===========================================
# HelpDesk.AI Frontend Configuration
# ===========================================
# Copy this file to Frontend/.env and fill in your values.

# --- Supabase (REQUIRED for auth & database) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Backend API URL ---
VITE_BACKEND_URL=http://localhost:8000

# --- Stripe (for growth/subscription links, optional) ---
VITE_STRIPE_GROWTH_LINK=your-stripe-link-here

# --- AI Provider: Google Gemini API Keys (optional) ---
# You can provide up to 4 API keys for load balancing.
# Get keys at https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY_1=
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=
VITE_GEMINI_API_KEY_4=
# Comma-separated Gemini models to use (default: gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash)
VITE_AI_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# --- AI Provider: OpenRouter API Keys (optional) ---
# Up to 4 keys for load balancing. Get keys at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY_1=
VITE_OPENROUTER_API_KEY_2=
VITE_OPENROUTER_API_KEY_3=
VITE_OPENROUTER_API_KEY_4=
# Comma-separated OpenRouter models to use
VITE_AI_OPENROUTER_MODELS=meta-llama/llama-3.2-3b-instruct:free,microsoft/phi-3-mini-128k-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free

# --- AI Provider: Groq API Keys (optional) ---
# Up to 3 keys for load balancing. Get keys at https://console.groq.com/keys
VITE_GROQ_API_KEY_1=
VITE_GROQ_API_KEY_2=
VITE_GROQ_API_KEY_3=
# Comma-separated Groq models to use
VITE_AI_GROQ_MODELS=llama-3.1-8b-instant,mixtral-8x7b-32768,gemma2-9b-it
